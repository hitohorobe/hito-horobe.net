# 記事コンテンツを他のリポジトリからとる
# Netlifyでは Site configuration > Environment variables に同名で登録する
CONTENT_REPO_URL=
# private repoの場合、contents:read権限のGitHub PATを設定する(publicなら不要)
CONTENT_REPO_TOKEN=
# 同期するブランチ名
CONTENT_REPO_BRANCH=main

# microCMSからのマイグレーション用設定（移行完了後は不要）
# MICROCMS_SERVICE_DOMAIN=<YOUR_SERVICE_DOMAIN>
# MICROCMS_API_KEY=<API_KEY>
