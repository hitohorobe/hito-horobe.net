---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Related from "../../components/Related.astro";
import Sharebuttons from '../../components/ShareButtons.astro';
import DateCategoryTags from "../../components/DateCategoryTags.astro";
import { getArticles, getArticleBySlug } from "../../libs/content"
import { DOMAIN, SITE_NAME } from "../../const"

export async function getStaticPaths() {
    const articles = await getArticles();
    return articles.map((article) => ({
        params: { slug: article.slug },
    }));
}

const { slug } = Astro.params;
const result = await getArticleBySlug(slug as string);
if (!result) {
    return Astro.redirect("/404");
}
const { article, Content } = result;
const relatedArticles = (await getArticles()).slice(0, 4);
---
<BaseLayout
  pageTitle={`${article.title} | ${SITE_NAME}`}
  description={article.leadText}
  image={article.thumbnail.src}
  url={`https://${DOMAIN}/articles/${slug}`}
>
<container class="max-w-[1100px] mx-auto flex flex-wrap m-3">
  <div class="flex-1 mr-4 min-w-0">
  <article class="p-3" data-pagefind-body>
        <div>
          <h1>{article.title}</h1>
          <DateCategoryTags article={article} />

          <div class="max-h-[350px] overflow-hidden flex justify-center items-center">
            <Image
                src={article.thumbnail.src}
                alt={article.thumbnail.alt ?? `img_${article.title}/`}
                width={800}
                height={450}
              />
          </div>
        </div>

        <p class="py-5">{article.leadText}</p>
          <div class="
              min-w-0 break-words
              [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:my-6
              [&_h3]:text-lg [&_h3]:font-bold [&_h3]:my-3
              [&_blockquote]:border-l-4
              [&_blockquote]:p-3
              [&_blockquote]:mx-9
              [&_blockquote]:border-blue-500 [&_blockquote]:bg-[#f5f5f5]
              [&_p]:mx-3 [&_p]:my-6 [&_p]:text-base
              [&_a]:underline [&_a]:text-blue-600 [&_a]:break-all
              [&_ul]:my-6
              [&_li]:list-disc
              [&_figure]:flex [&_figure]:flex-col [&_figure]:items-center [&_figure]:max-w-full
              [&_img]:max-w-full"
          >
            <Content />
          </div>
          <Related articles={relatedArticles} />
          <Sharebuttons
            slug={article.slug}
            title={encodeURIComponent(`${article.title} | ${SITE_NAME}`)}
          />

        </article>
        <DateCategoryTags article={article} />
      </div>
    <div id="sidebar" class="hidden md:block md:w-1/4 lg:w-1/3 max-w-[280px]">
      <Navigation />
    </div>
    </div>
  </div>
</BaseLayout>

<style>
  .date {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0.5rem;
  }

  .date .category {
    list-style: none;
    background-image: url("/category.svg");
    background-size: 1.2rem;
    background-repeat: no-repeat;
    padding-left: 1.5rem;
    margin: 0.25rem;
  }

  .date .published-at {
    list-style: none;
    background-image: url("/published.svg");
    background-size: 1.2rem;
    background-repeat: no-repeat;
    padding-left: 1.5rem;
    margin: 0.25rem;
  }

  .date .updated-at {
    list-style: none;
    background-image: url("/update.svg");
    background-size: 1.2rem;
    background-repeat: no-repeat;
    padding-left: 1.5rem;
    margin: 0.25rem;
  }

  .tag {
    display: flex;
    flex-wrap: wrap;
    margin: 0.5rem;
  }

  .tag li {
    background-color: #ddf4ff;
    margin: 0.2rem 0.25rem 0 0;
    padding: 0.25rem 0.5rem;
    list-style: none;
    border-radius: 1rem;
    font-weight: bold;
    color: #0969da;
  }

  .tag li:hover {
    background-color: #0969da;
    color: #ffffff;
  }

  h1 {
    text-align: center;
  }

  .main_text {
    font: 400 14px/20px 'Helvetica Neue', 'Arial', 'sans-serif;'
  }
  .main_text h2 {
    font-size: 1.5rem;
    font-weight: bold;
    margin: 2rem 0;
  }

  .main_text h3 {
    font-size: 1.25rem;
    font-weight: bold;
    margin: 1.5rem 0;
  }
</style>
