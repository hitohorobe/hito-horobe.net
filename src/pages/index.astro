---
// 記事一覧を取得
import { getArticles } from "../libs/content";
import BlogLayout from "../layouts/BlogLayout.astro";
import { DOMAIN } from "../const"
const pageTitle = "hito-horobe.net";
const articles = (await getArticles()).slice(0, 10);
---
<BlogLayout 
  pageTitle={pageTitle}
  articles={articles}
  description="@hito_horobeのブログ"
  image="https://hito-horobe.net/ogp-index.jpg"
  url=`https://${DOMAIN}`
>
<!-- archives/1 へのリンクを中央揃えで配置 -->
<div class="text-center">
    <a href="/archives/1" class="text-xl underline font-medium">過去記事一覧へ</a>
</div>
</BaseLayout>

